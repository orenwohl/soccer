{
	"name": "soccer-app",
	"version": "1.0.0",
	"private": true,
	"description": "Neighborhood Soccer App",
	"main": "index.js",
	"workspaces": [
		"frontend",
		"backend"
	],
	"scripts": {
		"frontend": "cd frontend && npm run dev",
		"backend": "cd backend && npm run dev",
		"all": "concurrently \"npm run backend\" \"npm run frontend\"",
		"build": "cd backend && npm run build && cd ../frontend && npm run build"
	},
	"dependencies": {
		"concurrently": "^8.2.2"
	},
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"npm-run-all": "^4.1.5"
	}
}
